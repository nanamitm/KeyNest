<Window x:Class="KeyNest.App.Views.ChangeMasterPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="マスターパスワードの変更" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20,16,20,16">
        <TextBlock Text="今のマスターパスワード" Margin="0,0,0,4" />
        <PasswordBox x:Name="CurrentInput" />

        <TextBlock Text="新しいマスターパスワード" Margin="0,14,0,4" />
        <PasswordBox x:Name="NewInput" PasswordChanged="NewInput_PasswordChanged" />
        <TextBlock x:Name="StrengthText" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

        <TextBlock Text="新しいマスターパスワード（確認）" Margin="0,10,0,4" />
        <PasswordBox x:Name="ConfirmInput" />

        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="変更すると、データファイルはすぐに新しいパスワードで保存し直されます（未保存の変更も含めて保存します）。新しいパスワードを忘れるとデータを復元できません。" />
        <TextBlock x:Name="HelloNoteText" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Visibility="Collapsed"
                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                   Text="Windows Hello の登録は無効になります。変更後に登録し直すかを確認します。" />

        <TextBlock x:Name="ErrorText" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="OkButton" Content="変更" Width="100" Style="{StaticResource AccentButtonStyle}" IsDefault="True" Click="Ok_Click" />
            <Button Content="キャンセル" Width="90" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
