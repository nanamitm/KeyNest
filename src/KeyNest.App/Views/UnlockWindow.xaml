<Window x:Class="KeyNest.App.Views.UnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyNest" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock x:Name="HeadingText" FontSize="16" FontWeight="SemiBold" />
        <TextBlock x:Name="PathText" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />

        <!-- Windows Hello（登録済みのときだけ表示） -->
        <StackPanel x:Name="HelloPanel" Visibility="Collapsed">
            <Button x:Name="HelloButton" Margin="0,16,0,0" HorizontalAlignment="Stretch" Padding="12,8" Click="Hello_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE928;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock x:Name="HelloButtonText" Text="Windows Hello でロック解除" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock Text="または" Margin="0,12,0,0" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>

        <TextBlock Text="マスターパスワード" Margin="0,16,0,4" />
        <PasswordBox x:Name="PasswordInput" />

        <StackPanel x:Name="ConfirmPanel">
            <TextBlock Text="マスターパスワード（確認）" Margin="0,10,0,4" />
            <PasswordBox x:Name="ConfirmInput" />
            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap"
                       Text="マスターパスワードを忘れるとデータを復元できません。" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Margin="0,10,0,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="OkButton" Width="110" Style="{StaticResource AccentButtonStyle}" IsDefault="True" Click="Ok_Click" />
            <Button x:Name="CancelButton" Content="終了" Width="90" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
