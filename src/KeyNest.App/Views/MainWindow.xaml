<Window x:Class="KeyNest.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KeyNest.App.ViewModels"
        Title="{Binding WindowTitle}" Width="1100" Height="680" MinWidth="820" MinHeight="460"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding AddEntryCommand}" />
        <KeyBinding Gesture="Ctrl+D1" Command="{Binding CopyFieldCommand}" CommandParameter="0" />
        <KeyBinding Gesture="Ctrl+D2" Command="{Binding CopyFieldCommand}" CommandParameter="1" />
        <KeyBinding Gesture="Ctrl+D3" Command="{Binding CopyFieldCommand}" CommandParameter="2" />
        <KeyBinding Gesture="Ctrl+D4" Command="{Binding CopyFieldCommand}" CommandParameter="3" />
        <KeyBinding Gesture="Ctrl+U" Command="{Binding OpenUrlCommand}" />
        <KeyBinding Gesture="Ctrl+M" Command="{Binding OpenMailCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+V" Command="{Binding AutoTypeCommand}" />
        <KeyBinding Gesture="Ctrl+L" Command="{Binding LockCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,12,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ツールバー -->
        <DockPanel DockPanel.Dock="Top" Margin="12,10,12,8" LastChildFill="False">
            <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding AddEntryCommand}" ToolTip="新しいエントリ (Ctrl+N)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                    <TextBlock Text="エントリ" />
                </StackPanel>
            </Button>
            <Button Command="{Binding AddGroupCommand}" Margin="6,0,0,0" ToolTip="選択中のグループの下に追加">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8F4;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                    <TextBlock Text="グループ" />
                </StackPanel>
            </Button>
            <Button Command="{Binding SaveCommand}" Margin="6,0,0,0" ToolTip="保存 (Ctrl+S)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                    <TextBlock Text="保存" />
                </StackPanel>
            </Button>
            <Button Command="{Binding LockCommand}" Margin="6,0,0,0" ToolTip="ロック (Ctrl+L)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                    <TextBlock Text="ロック" />
                </StackPanel>
            </Button>
            <Button Command="{Binding PersonalInfoCommand}" Margin="6,0,0,0" ToolTip="氏名・住所などの個人情報">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                    <TextBlock Text="個人情報" />
                </StackPanel>
            </Button>
            <Button Command="{Binding ImportIdManagerCommand}" Margin="6,0,0,0" ToolTip="ID Manager の XML 出力を取り込む">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8B5;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                    <TextBlock Text="取り込み" />
                </StackPanel>
            </Button>
            <Button Command="{Binding ExportCommand}" Margin="6,0,0,0" ToolTip="CSV・XML に書き出す（暗号化されません）">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE898;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                    <TextBlock Text="書き出し" />
                </StackPanel>
            </Button>
            <Button Command="{Binding SettingsCommand}" Margin="6,0,0,0" ToolTip="設定">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                    <TextBlock Text="設定" />
                </StackPanel>
            </Button>
            <Grid DockPanel.Dock="Right" Width="260">
                <TextBox x:Name="SearchBox" Padding="32,6,8,6" ToolTip="検索 (Ctrl+F)"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="11,0,0,0" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DockPanel>

        <!-- ステータスバー -->
        <DockPanel DockPanel.Dock="Bottom" Margin="14,0,14,8">
            <TextBlock DockPanel.Dock="Right" Text="{Binding FilePath}" TextTrimming="CharacterEllipsis" MaxWidth="520"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" ToolTip="{Binding FilePath}" />
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </DockPanel>

        <Grid Margin="12,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="400" MinWidth="220" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- グループとエントリのツリー -->
            <Border Style="{StaticResource Card}" Padding="4">
                <TreeView x:Name="NodeTree" ItemsSource="{Binding RootGroups}" BorderThickness="0" Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectedItemChanged="NodeTree_SelectedItemChanged"
                          MouseDoubleClick="NodeTree_MouseDoubleClick"
                          AllowDrop="True"
                          PreviewMouseLeftButtonDown="NodeTree_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="NodeTree_PreviewMouseMove"
                          DragOver="NodeTree_DragOver" DragLeave="NodeTree_DragLeave" Drop="NodeTree_Drop">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type vm:GroupViewModel}" ItemsSource="{Binding Nodes}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                            <Setter Property="Text" Value="&#xE8B7;" />
                                            <Setter Property="Foreground" Value="#E3A21A" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                    <Setter Property="Text" Value="&#xE838;" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                                    <Setter Property="Text" Value="&#xE8F1;" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding TotalCount, StringFormat=({0})}" Margin="6,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                        <DataTemplate DataType="{x:Type vm:EntryViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8D7;" Style="{StaticResource Icon}" Margin="0,0,8,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <!-- 有効期限が近い・切れているときだけ警告マーク（名前が長くても見えるよう名前の前に置く） -->
                                <TextBlock Text="&#xE7BA;" Margin="0,0,6,0" ToolTip="{Binding ExpirationText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ExpirationState}" Value="Soon">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ExpirationState}" Value="Expired">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Subtitle}" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </TreeView.Resources>
                    <TreeView.ItemContainerStyle>
                        <!--
                          Fluent 標準のテンプレートは項目全体（子を含む）の IsMouseOver で見出しを塗るため、
                          子にマウスがあると祖先グループまで帯状に光る。見出し行だけで判定する自前テンプレートに置き換える。
                        -->
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay, FallbackValue=False}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TreeViewItem">
                                        <StackPanel>
                                            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                                    CornerRadius="4" Margin="0,0,0,1" Padding="0,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle x:Name="Indicator" Width="3" Height="16" RadiusX="2" RadiusY="2"
                                                               HorizontalAlignment="Left" Visibility="Collapsed"
                                                               Fill="{DynamicResource TreeViewItemSelectionIndicatorForeground}" />
                                                    <ToggleButton x:Name="Expander" Width="26" Focusable="False" ClickMode="Press"
                                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="Transparent">
                                                                    <TextBlock x:Name="Chevron" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>
                                                    <ContentPresenter Grid.Column="1" x:Name="PART_Header" ContentSource="Header" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <ItemsPresenter x:Name="ItemsHost" Margin="18,0,0,0" Visibility="Collapsed" />
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="HasItems" Value="False">
                                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                            </Trigger>
                                            <Trigger Property="IsExpanded" Value="True">
                                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TreeViewItemBackgroundPointerOver}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TreeViewItemBackgroundSelected}" />
                                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TreeViewItemBackgroundPointerOver}" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="エントリを追加" InputGestureText="Ctrl+N" Command="{Binding AddEntryCommand}" />
                            <MenuItem Header="グループを追加" Command="{Binding AddGroupCommand}" />
                            <Separator />
                            <MenuItem Header="{Binding SelectedEntry.Fields[0].Label}" HeaderStringFormat="「{0}」をコピー"
                                      InputGestureText="Ctrl+1" Command="{Binding CopyFieldCommand}" CommandParameter="0" />
                            <MenuItem Header="{Binding SelectedEntry.Fields[1].Label}" HeaderStringFormat="「{0}」をコピー"
                                      InputGestureText="Ctrl+2" Command="{Binding CopyFieldCommand}" CommandParameter="1" />
                            <MenuItem Header="{Binding SelectedEntry.Fields[2].Label}" HeaderStringFormat="「{0}」をコピー"
                                      InputGestureText="Ctrl+3" Command="{Binding CopyFieldCommand}" CommandParameter="2" />
                            <MenuItem Header="{Binding SelectedEntry.Fields[3].Label}" HeaderStringFormat="「{0}」をコピー"
                                      InputGestureText="Ctrl+4" Command="{Binding CopyFieldCommand}" CommandParameter="3" />
                            <MenuItem Header="自動入力" InputGestureText="Ctrl+Shift+V" Command="{Binding AutoTypeCommand}" FontWeight="SemiBold" />
                            <MenuItem Header="URL を開く" InputGestureText="Ctrl+U" Command="{Binding OpenUrlCommand}" />
                            <MenuItem Header="メールを作成" InputGestureText="Ctrl+M" Command="{Binding OpenMailCommand}" />
                            <Separator />
                            <MenuItem Header="グループ名を変更" Command="{Binding RenameGroupCommand}" />
                            <MenuItem Header="グループを削除" Command="{Binding DeleteGroupCommand}" />
                            <MenuItem Header="エントリを削除" Command="{Binding DeleteEntryCommand}" />
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- 詳細 -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,2,14,14">
                <Grid>
                    <TextBlock Text="エントリを選択してください" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedEntry}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedEntry}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <!-- 各行は「項目名 | 値 | ボタン」の3列。SharedSizeGroup で全行の列幅をそろえる -->
                        <!--
                          MinHeight を表示領域の高さに合わせ、余った高さを備考欄（* 行）に割り当てる。
                          内容が収まらないほど小さくしたときだけスクロールバーが出る。
                          右余白はスクロールバーがボタンに重ならないように。
                        -->
                        <Grid DataContext="{Binding SelectedEntry}" Margin="0,0,16,0" Grid.IsSharedSizeScope="True"
                              MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" SharedSizeGroup="Label" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Buttons" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="タイトル" Style="{StaticResource RowLabel}" />
                                    <TextBox Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" />
                                </Grid>

                                <TextBlock Margin="0,18,0,2" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="項目名・伏せ字はこのエントリだけの設定です。左の項目名は自由に書き換えられます。" TextWrapping="Wrap" />

                                <!-- 汎用欄 x4 -->
                                <ItemsControl ItemsSource="{Binding Fields}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" SharedSizeGroup="Label" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Buttons" />
                                                </Grid.ColumnDefinitions>

                                                <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                         ToolTip="{Binding Shortcut, StringFormat=項目名（自由に変更できます） コピー: {0}}" />

                                                <Grid Grid.Column="1">
                                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                             Visibility="{Binding ShowValue, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBox Text="{Binding MaskedText, Mode=OneWay}" IsReadOnly="True"
                                                             ToolTip="目のボタンで表示・編集できます"
                                                             Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ShowValue}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                </Grid>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                                                    <ToggleButton ToolTip="伏せ字にする" IsChecked="{Binding IsMasked}">
                                                        <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" />
                                                    </ToggleButton>
                                                    <ToggleButton Margin="4,0,0,0" ToolTip="表示 / 非表示" IsChecked="{Binding IsRevealed}">
                                                        <ToggleButton.Style>
                                                            <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMasked}" Value="False">
                                                                        <Setter Property="Visibility" Value="Hidden" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                        <TextBlock Text="&#xE7B3;" Style="{StaticResource Icon}" />
                                                    </ToggleButton>
                                                    <Button Margin="4,0,0,0" ToolTip="{Binding Shortcut, StringFormat=コピー ({0})}" ToolTipService.ShowOnDisabled="True"
                                                            Command="{Binding DataContext.CopyFieldCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" />
                                                    </Button>
                                                    <Button Margin="4,0,0,0" ToolTip="ランダムな値を生成"
                                                            Command="{Binding DataContext.GenerateFieldCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" SharedSizeGroup="Label" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Buttons" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="URL" Style="{StaticResource RowLabel}" />
                                    <TextBox Grid.Column="1" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="2" Margin="6,0,0,0" HorizontalAlignment="Right" ToolTip="ブラウザで開く (Ctrl+U)"
                                            Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" />
                                    </Button>
                                </Grid>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" SharedSizeGroup="Label" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Buttons" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="メール" Style="{StaticResource RowLabel}" />
                                    <TextBox Grid.Column="1" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="2" Margin="6,0,0,0" HorizontalAlignment="Right" ToolTip="メールソフトを起動 (Ctrl+M)"
                                            Command="{Binding DataContext.OpenMailCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <TextBlock Text="&#xE715;" Style="{StaticResource Icon}" />
                                    </Button>
                                </Grid>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" SharedSizeGroup="Label" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Buttons" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ファイル" Style="{StaticResource RowLabel}" />
                                    <TextBox Grid.Column="1" Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0" HorizontalAlignment="Right">
                                        <Button Margin="0" ToolTip="ファイルを選択"
                                                Command="{Binding DataContext.BrowseFileCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" />
                                        </Button>
                                        <Button Margin="4,0,0,0" ToolTip="ファイルを開く"
                                                Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" SharedSizeGroup="Label" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Buttons" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="シリアル番号" Style="{StaticResource RowLabel}" />
                                    <TextBox Grid.Column="1" Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0" HorizontalAlignment="Right">
                                        <Button Margin="0" ToolTip="シリアル番号をコピー"
                                                Command="{Binding DataContext.CopySerialCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" SharedSizeGroup="Label" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Buttons" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="発行日" Style="{StaticResource RowLabel}" />
                                    <Grid Grid.Column="1" Grid.ColumnSpan="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <DatePicker SelectedDate="{Binding IssueDate}" />
                                        <TextBlock Grid.Column="1" Text="有効期限" Margin="16,0,8,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <DatePicker Grid.Column="2" SelectedDate="{Binding ExpirationDate}" />
                                        <TextBlock Grid.Column="3" Text="{Binding ExpirationText}" Margin="8,0,0,0" MinWidth="64"
                                                   VerticalAlignment="Center" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ExpirationState}" Value="Soon">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ExpirationState}" Value="Expired">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" SharedSizeGroup="Label" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Buttons" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="貼り付け方法" Style="{StaticResource RowLabel}" />
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" DisplayMemberPath="Name"
                                              ItemsSource="{Binding DataContext.AutoTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding DataContext.SelectedAutoType, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0" HorizontalAlignment="Right">
                                        <Button ToolTip="直前のウィンドウへ自動入力 (Ctrl+Shift+V)" Style="{StaticResource AccentButtonStyle}"
                                                Command="{Binding DataContext.AutoTypeCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <TextBlock Text="&#xE765;" Style="{StaticResource Icon}" />
                                        </Button>
                                        <Button Margin="4,0,0,0" ToolTip="貼り付けタイプの編集"
                                                Command="{Binding DataContext.EditAutoTypesCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="備考" Style="{StaticResource FieldLabel}" />
                            </StackPanel>

                            <TextBox Grid.Row="1" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                     TextWrapping="Wrap" MinHeight="110" VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto" />

                            <TextBlock Grid.Row="2" Margin="0,12,0,4" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="{Binding Modified, StringFormat=更新日時: {0:yyyy/MM/dd HH:mm}}" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
