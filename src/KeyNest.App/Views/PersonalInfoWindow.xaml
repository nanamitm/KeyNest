<Window x:Class="KeyNest.App.Views.PersonalInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="個人情報" Width="860" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <DataTemplate x:Key="RowTemplate">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding ShowInMenu}" MinWidth="0" VerticalAlignment="Center"
                          ToolTip="トレイ・ホットキーのメニューに表示する" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="4,0,8,0" />
                <TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <StackPanel Margin="20,16,20,16">
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,14"
                   Text="フォームへの入力に使う個人情報です。データファイルに暗号化して保存します。左のチェックを付けた項目は、トレイ・ホットキーのメニューの「個人情報」からコピー・貼り付けできます。貼り付けタイプのコマンドとしても使えます。" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="✓ メニューに表示" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <ItemsControl x:Name="LeftRows" ItemTemplate="{StaticResource RowTemplate}" Focusable="False" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="✓ メニューに表示" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <ItemsControl x:Name="RightRows" ItemTemplate="{StaticResource RowTemplate}" Focusable="False" />
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Width="90" Style="{StaticResource AccentButtonStyle}" IsDefault="True" Click="Ok_Click" />
            <Button Content="キャンセル" Width="90" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
