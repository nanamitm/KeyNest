<Window x:Class="KeyNest.App.Views.PasswordGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="パスワードの生成" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20,16,20,16">
        <!-- 生成結果 -->
        <DockPanel>
            <Button DockPanel.Dock="Right" Margin="6,0,0,0" ToolTip="同じ条件で作り直す" Click="Generate_Click">
                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" />
            </Button>
            <TextBox x:Name="ResultBox" FontFamily="Consolas" FontSize="15" />
        </DockPanel>

        <!-- 条件 -->
        <TextBlock Text="使う文字" FontWeight="SemiBold" Margin="0,18,0,6" />
        <UniformGrid Columns="2">
            <CheckBox x:Name="UpperBox" Content="英大文字（ABC）" Checked="Option_Changed" Unchecked="Option_Changed" />
            <CheckBox x:Name="LowerBox" Content="英小文字（abc）" Checked="Option_Changed" Unchecked="Option_Changed" />
            <CheckBox x:Name="DigitsBox" Content="数字（123）" Checked="Option_Changed" Unchecked="Option_Changed" />
            <CheckBox x:Name="SymbolsBox" Content="記号（#$/ など）" Checked="Option_Changed" Unchecked="Option_Changed" />
        </UniformGrid>
        <CheckBox x:Name="ExcludeAmbiguousBox" Content="見間違えやすい文字（I l 1 O 0 o |）を使わない" Margin="0,4,0,0"
                  Checked="Option_Changed" Unchecked="Option_Changed" />

        <TextBlock Text="文字数" FontWeight="SemiBold" Margin="0,16,0,6" />
        <DockPanel>
            <TextBox x:Name="LengthBox" DockPanel.Dock="Right" Width="70" Margin="12,0,0,0" HorizontalContentAlignment="Right"
                     TextChanged="LengthBox_TextChanged" />
            <Slider x:Name="LengthSlider" Minimum="1" Maximum="128" SmallChange="1" LargeChange="8" IsSnapToTickEnabled="True"
                    TickFrequency="1" VerticalAlignment="Center" ValueChanged="LengthSlider_ValueChanged" />
        </DockPanel>

        <TextBlock x:Name="ErrorText" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="ApplyButton" MinWidth="120" Style="{StaticResource AccentButtonStyle}" IsDefault="True" Click="Apply_Click" />
            <Button x:Name="CopyButton" Content="コピー" Width="90" Margin="8,0,0,0" Click="Copy_Click" />
            <Button Content="閉じる" Width="90" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
